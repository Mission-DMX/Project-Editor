        "tilt_value": "{{ 0.5 + (([size * 57.2958 / distance, pan_range_deg / 2, tilt_range_deg / 2] | min) / tilt_range_deg) * 0.382683 }}",
        "tilt_curvesel": "0"
      }
    },
